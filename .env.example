# ==============================================================================
# Kaaravan Platform Environment Variables
# ==============================================================================
# NON-NEGOTIABLE SECURITY RULES:
# 1. NEXT_PUBLIC_* variables are exposed to the browser.
# 2. SUPABASE_SERVICE_ROLE_KEY is STRICTLY server-only. NEVER expose it to the browser.
# 3. NEVER commit real secret keys into version control.
# ==============================================================================

# Supabase Public API (Accessible by client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Service Role Key (Bypasses RLS - Server Actions & Route Handlers only)
# NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Platform Deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internationalization
DEFAULT_LOCALE=en

# Currency default (Stored as integer minor units: Paisa)
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR
